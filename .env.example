# Copy to .env and adjust. NEVER commit the real .env.
# The values below are fine for a local run, but MUST be changed for any public deployment.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=salon
POSTGRES_USER=salon
POSTGRES_PASSWORD=change-me-db-password

# --- Backend ------------------------------------------------------------------
# Secret used to sign JWTs (HS256). At least 32 characters. Generate e.g. with:  openssl rand -base64 48
JWT_SECRET=change-me-please-use-a-long-random-secret-0123456789

# Comma separated list of browser origins allowed to call the API (only needed when the frontend is served from another origin).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Public URL of the frontend (used in password reset links).
FRONTEND_URL=http://localhost:3000

# true = create demo accounts (admin@salon.ro / client@example.com) and demo reservations on an empty database.
# Set to false in production.
SEED_DEMO_DATA=true

# Time zone of the server process; keep it equal to the salon time zone (Admin -> Setări).
SALON_TIMEZONE=Europe/Bucharest

# --- Ports --------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080

# --- Reserved for future integrations (not used yet) --------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMS_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
